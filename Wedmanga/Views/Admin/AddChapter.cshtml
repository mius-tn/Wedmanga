@{
    ViewData["Title"] = "Thêm Chương Mới";
    Layout = "_AdminLayout";
}

<!-- Cho Multi-select Thể loại -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<!-- Cho Markdown Editor -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/simplemde/latest/simplemde.min.css">
<script src="https://cdn.jsdelivr.net/simplemde/latest/simplemde.min.js"></script>

<!-- Cho Kéo Thả Sắp Xếp Ảnh (SortableJS) -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

<style>
    .form-label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        color: var(--text-primary);
        font-size: 0.95rem;
    }
    
    .required::after {
        content: '*';
        color: #ff4d4f;
        margin-left: 4px;
    }

    /* Style cho MDEditor matcha */
    .editor-toolbar {
        border-color: var(--border-color);
        background: var(--bg-surface);
        border-radius: var(--radius-md) var(--radius-md) 0 0;
    }
    .CodeMirror {
        border-color: var(--border-color);
        border-radius: 0 0 var(--radius-md) var(--radius-md);
        font-family: inherit;
    }
    .editor-toolbar a.active, .editor-toolbar a:hover {
        background: rgba(207, 232, 213, 0.4);
        border-color: var(--color-matcha);
    }
    
    .upload-btn-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
        width: 100%;
    }

    .upload-btn-wrapper input[type=file] {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
        cursor: pointer;
    }

    /* Drag & Drop Cover for Chapter Images */
    .images-upload-box {
        border: 2px dashed var(--border-color);
        border-radius: var(--radius-lg);
        background: var(--bg-body);
        padding: 2rem;
        text-align: center;
        cursor: pointer;
        transition: var(--transition-smooth);
        min-height: 200px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }

    .images-upload-box:hover, .images-upload-box.dragover {
        border-color: var(--color-matcha);
        background: rgba(207, 232, 213, 0.2);
    }

    .images-upload-box i {
        font-size: 3rem;
        color: var(--text-secondary);
        margin-bottom: 1rem;
    }
    
    .images-input {
        position: absolute;
        width: 100%; height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .preview-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 15px;
    }

    .preview-image-wrapper {
        position: relative;
        width: 100px;
        height: 140px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .preview-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>

<form asp-controller="Admin" asp-action="AddChapter" method="post" enctype="multipart/form-data">
<div class="admin-card" style="max-width: 900px; margin: 0 auto;">
    <h3 style="margin-top:0; margin-bottom: 1.5rem; color: var(--text-primary); border-bottom: 2px solid var(--color-matcha); padding-bottom: 10px; display:inline-block;">Thông Tin Chương</h3>
    
    @Html.ValidationSummary(false, "", new { @class = "text-danger", style = "margin-bottom: 1rem; color: #ff4d4f; font-weight: bold;" })
    
    <div style="margin-bottom: 1.5rem;">
        <label class="form-label required">Chọn Truyện</label>
        <select class="admin-input" id="storySelect" name="storyId" required>
            <option value="">-- Tìm và chọn truyện --</option>
            @if(ViewBag.Stories != null) {
                foreach(var s in ViewBag.Stories) {
                    var isTruyenChuStr = s.IsTruyenChu ? "true" : "false";
                    <option value="@s.StoryId" data-istruyenchu="@isTruyenChuStr" selected="@(ViewBag.SelectedStoryId == s.StoryId ? "selected" : null)">@s.Title</option>
                }
            }
        </select>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; margin-bottom: 1.5rem;">
        <div>
            <label class="form-label required">Số Chương</label>
            <input type="number" name="chapterNumber" class="admin-input" placeholder="VD: 24" value="@(ViewBag.ChapterNumber ?? "")" required>
        </div>
        <div>
            <label class="form-label">Tên Chương (Tiêu đề phụ)</label>
            <input type="text" name="title" class="admin-input" placeholder="VD: Lời Tỏ Tình Dưới Tán Hoa" value="@(ViewBag.ChapterTitle ?? "")">
        </div>
    </div>

    <div id="textEditorSection" style="margin-bottom: 1.5rem; display: none;">
        <label class="form-label required">Nội Dung Chương (Hỗ trợ Markdown)</label>
        <textarea id="markdownEditor" name="content" rows="10"></textarea>
    </div>

    <div id="imageUploadSection" style="margin-bottom: 1.5rem; display: none;">
        <label class="form-label required">Tải Lên Ảnh Truyện Tranh</label>
        <div class="images-upload-box" id="dropZone">
            <input type="file" id="chapterImages" name="chapterImages" class="images-input" accept="image/*" multiple>
            <span class="material-symbols-rounded" style="font-size: 3rem; color: var(--text-secondary); margin-bottom: 1rem;">collections</span>
            <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 4px;">Kéo thả ảnh vào đây</div>
            <div style="font-size: 0.8rem; color: var(--text-secondary);">hoặc click để chọn nhiều tệp (JPG, PNG)</div>
        </div>
        <div class="preview-container" id="previewContainer"></div>
    </div>

    <div style="display: flex; gap: 10px; justify-content: flex-end; padding-top: 1rem;">
        <a asp-controller="Admin" asp-action="Chapters" class="admin-btn" style="background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-primary);">Hủy</a>
        <button type="submit" class="admin-btn btn-primary" style="background-color: var(--color-matcha); color: #2c7a4b;">
            <span class="material-symbols-rounded">publish</span> Xuất Bản Ngay
        </button>
    </div>
</div>
</form>

<script>
    $(document).ready(function() {
        $('#storySelect').select2();
        
        var simplemde = new SimpleMDE({ 
            element: document.getElementById("markdownEditor"),
            spellChecker: false,
            placeholder: "Nhập nội dung truyện chữ tại đây..."
        });

        function toggleInputSections() {
            var selectedOption = $('#storySelect').find('option:selected');
            if (!selectedOption.val()) {
                $('#textEditorSection').hide();
                $('#imageUploadSection').hide();
                return;
            }

            var isTruyenChu = selectedOption.data('istruyenchu');
            
            if (isTruyenChu === true || isTruyenChu === "true") {
                $('#textEditorSection').show();
                $('#imageUploadSection').hide();
                // Bỏ validation cứng của HTML5 để tự xử lý bằng JS lúc submit nếu cần
                document.getElementById('chapterImages').required = false;
            } else {
                $('#textEditorSection').hide();
                $('#imageUploadSection').show();
                // Bỏ required HTML5 vì trình duyệt sẽ ẩn thẻ và không cho báo lỗi
                document.getElementById('chapterImages').required = false;
                // clear text editor so backend doesn't complain
                simplemde.value(""); 
            }
        }

        $('#storySelect').on('change', function() {
            toggleInputSections();
        });

        // Run on load to set initial state
        toggleInputSections();

        // Xử lý Validation thủ công khi Submit Form
        $('form').on('submit', function(e) {
            var selectedOption = $('#storySelect').find('option:selected');
            if (selectedOption.val()) {
                var isTruyenChu = selectedOption.data('istruyenchu');
                if (isTruyenChu === false || isTruyenChu === "false") {
                    if (selectedFiles.length === 0) {
                        e.preventDefault(); // Chặn gửi form
                        alert("Vui lòng tải lên ít nhất 1 ảnh cho truyện tranh!");
                        return false;
                    }
                } else {
                    if (simplemde.value().trim() === "") {
                        e.preventDefault();
                        alert("Vui lòng nhập nội dung cho truyện chữ!");
                        return false;
                    }
                }
            }
        });

        // Image Preview & Sorting Logic
        const imagesInput = document.getElementById('chapterImages');
        const previewContainer = document.getElementById('previewContainer');
        let selectedFiles = [];

        imagesInput.addEventListener('change', function(e) {
            // Khi người dùng chọn file mới qua input, gộp vào mảng hiện tại
            if (this.files && this.files.length > 0) {
                const newFiles = Array.from(this.files);
                selectedFiles = selectedFiles.concat(newFiles);
                updateFileInput(); // Cập nhật lại input.files bằng danh sách gộp
                renderPreviews();
            }
        });

        function updateFileInput() {
            const dt = new DataTransfer();
            selectedFiles.forEach(file => dt.items.add(file));
            imagesInput.files = dt.files;
        }

        function renderPreviews() {
            previewContainer.innerHTML = ''; // Xóa preview cũ
            selectedFiles.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'preview-image-wrapper';
                    wrapper.style.cursor = 'grab';
                    
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.title = file.name;
                    
                    wrapper.appendChild(img);
                    
                    // Add a badge with the index number (1-based)
                    const badge = document.createElement('div');
                    badge.className = 'badge-index';
                    badge.style.position = 'absolute';
                    badge.style.top = '5px';
                    badge.style.left = '5px';
                    badge.style.background = 'rgba(0,0,0,0.6)';
                    badge.style.color = 'white';
                    badge.style.padding = '2px 6px';
                    badge.style.borderRadius = '4px';
                    badge.style.fontSize = '12px';
                    badge.innerText = index + 1;
                    wrapper.appendChild(badge);

                    // Add a Delete button
                    const removeBtn = document.createElement('button');
                    removeBtn.className = 'remove-btn';
                    removeBtn.innerHTML = '&times;';
                    removeBtn.style.position = 'absolute';
                    removeBtn.style.top = '5px';
                    removeBtn.style.right = '5px';
                    removeBtn.style.background = '#ff4d4f';
                    removeBtn.style.color = 'white';
                    removeBtn.style.border = 'none';
                    removeBtn.style.borderRadius = '50%';
                    removeBtn.style.width = '20px';
                    removeBtn.style.height = '20px';
                    removeBtn.style.cursor = 'pointer';
                    removeBtn.style.display = 'flex';
                    removeBtn.style.alignItems = 'center';
                    removeBtn.style.justifyContent = 'center';
                    removeBtn.style.fontSize = '14px';
                    wrapper.appendChild(removeBtn);

                    previewContainer.appendChild(wrapper);
                }
                reader.readAsDataURL(file);
            });
        }

        // Ủy quyền sự kiện xóa ảnh (Event Delegation)
        previewContainer.addEventListener('click', function(e) {
            const btn = e.target.closest('.remove-btn');
            if (btn) {
                e.preventDefault();
                e.stopPropagation();
                
                const wrapper = btn.closest('.preview-image-wrapper');
                // Tìm vị trí của thẻ div trong container
                const index = Array.from(previewContainer.children).indexOf(wrapper);
                
                // Xóa khỏi mảng và xóa khỏi DOM
                selectedFiles.splice(index, 1);
                wrapper.remove();
                
                updateFileInput(); // Đồng bộ lại DataTransfer
                
                // Cập nhật lại số thứ tự trên các huy hiệu (badge) còn lại
                const items = previewContainer.children;
                for (let i = 0; i < items.length; i++) {
                    const badge = items[i].querySelector('.badge-index');
                    if (badge) badge.innerText = i + 1;
                }
            }
        });

        // Khởi tạo SortableJS cho previewContainer
        if (typeof Sortable !== 'undefined') {
            new Sortable(previewContainer, {
                animation: 150,
                ghostClass: 'sortable-ghost',
                onEnd: function (evt) {
                    if (evt.oldIndex === evt.newIndex) return;
                    
                    // Cập nhật lại thứ tự mảng JS
                    const movedItem = selectedFiles.splice(evt.oldIndex, 1)[0];
                    selectedFiles.splice(evt.newIndex, 0, movedItem);
                    
                    // Đồng bộ input.files (để gửi lên backend đúng thứ tự)
                    updateFileInput();
                    
                    // Cập nhật lại số thứ tự huy hiệu (Badge) thay vì re-render toàn bộ ảnh
                    const items = previewContainer.children;
                    for (let i = 0; i < items.length; i++) {
                        const badge = items[i].querySelector('.badge-index');
                        if (badge) badge.innerText = i + 1;
                    }
                },
            });
        }
    });
</script>
