@model Wedmanga.Models.Entities.Story
@{
    ViewData["Title"] = "Chỉnh Sửa Truyện";
    Layout = "_AdminLayout";
    var selectedCategories = ViewBag.SelectedCategories as List<int> ?? new List<int>();
}

<!-- Cho Multi-select Thể loại -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<style>
    .form-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; }
    .form-label { font-weight: 600; margin-bottom: 8px; display: block; color: var(--text-primary); font-size: 0.95rem; }
    .required::after { content: '*'; color: #ff4d4f; margin-left: 4px; }
    .cover-upload-box { border: 2px dashed var(--border-color); border-radius: var(--radius-lg); background: var(--bg-body); padding: 2rem; text-align: center; cursor: pointer; transition: var(--transition-smooth); min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; overflow: hidden; }
    .cover-upload-box:hover, .cover-upload-box.dragover { border-color: var(--color-matcha); background: rgba(207, 232, 213, 0.2); }
    .cover-upload-box i, .cover-upload-box span { font-size: 3rem; color: var(--text-secondary); margin-bottom: 1rem; }
    .cover-input { position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 5; }
    .select2-container--default .select2-selection--multiple { border: 1px solid var(--border-color); border-radius: var(--radius-md); min-height: 42px; background: transparent; }
    .select2-container--default.select2-container--focus .select2-selection--multiple { border-color: var(--color-matcha); }
    .select2-container--default .select2-selection--multiple .select2-selection__choice { background-color: var(--color-matcha); border: none; color: #2c7a4b; border-radius: 4px; padding: 4px 8px; margin-top: 6px; }
    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove { color: #2c7a4b; margin-right: 6px; }
    @@media (max-width: 900px) { .form-grid { grid-template-columns: 1fr; } }
</style>

<form asp-controller="Admin" asp-action="EditStory" method="post" enctype="multipart/form-data">
    <input type="hidden" name="storyId" value="@Model.StoryId" />
    <input type="hidden" name="currentCover" value="@Model.CoverImage" />
    
    <div class="form-grid">
        <div class="admin-card">
            <h3 style="margin-top:0; margin-bottom: 1.5rem; color: var(--text-primary);">Chỉnh Sửa Thông Tin</h3>
            
            <div style="margin-bottom: 1.25rem;">
                <label class="form-label required">Tên truyện</label>
                <input type="text" name="title" class="admin-input" value="@Model.Title" placeholder="VD: Hành Trình Hoa Anh Đào" required>
            </div>

            <div style="margin-bottom: 1.25rem;">
                <label class="form-label">Tên khác (Alternate Name / Slug)</label>
                <input type="text" name="alternateName" value="@Model.Slug" class="admin-input" placeholder="Tên tiếng Việt / Tiếng Nhật / Tiếng Anh...">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                <div>
                    <label class="form-label required">Tác giả</label>
                    <input type="text" name="author" class="admin-input" value="@Model.Author" required>
                </div>
                <div>
                    <label class="form-label required">Kiểu truyện</label>
                    <select name="type" class="admin-input" required>
                        <option value="Manga" selected="@(Model.Type == "Manga" ? "selected" : null)">Manga</option>
                        <option value="Light Novel" selected="@(Model.Type == "Light Novel" ? "selected" : null)">Light Novel</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 1.25rem;">
                <label class="form-label required">Thể loại</label>
                <select name="selectedCategories" class="admin-input select2-genres" id="genres" multiple="multiple" style="width: 100%;" required>
                    @if(ViewBag.Categories != null)
                    {
                        foreach(var cat in ViewBag.Categories)
                        {
                            <option value="@cat.CategoryId" selected="@(selectedCategories.Contains(cat.CategoryId) ? "selected" : null)">@cat.Name</option>
                        }
                    }
                </select>
            </div>

            <div style="margin-bottom: 1.25rem;">
                <label class="form-label">Mô tả nội dung</label>
                <textarea name="description" class="admin-input" rows="6">@Model.Description</textarea>
                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">Hỗ trợ định dạng văn bản cơ bản (Markdown).</div>
            </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div class="admin-card">
                <h3 style="margin-top:0; margin-bottom: 1rem; color: var(--text-primary);">Ảnh Bìa</h3>
                <div class="cover-upload-box" id="dropZone">
                    <input type="file" id="coverImage" name="coverImage" class="cover-input" accept="image/*">
                    <span class="material-symbols-rounded" style="position: relative; z-index: 10;">cloud_upload</span>
                    <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 4px; position: relative; z-index: 10;">Kéo thả ảnh mới vào đây</div>
                    <div style="font-size: 0.8rem; color: var(--text-secondary); position: relative; z-index: 10;">Bỏ trống nếu giữ ảnh cũ</div>
                    <img id="previewImage" src="@Model.CoverImage" style="display: block; width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0; border-radius: inherit; z-index: 2; opacity: 0.4;" />
                </div>
            </div>

            <div class="admin-card">
                <h3 style="margin-top:0; margin-bottom: 1rem; color: var(--text-primary);">Tùy Chỉnh Nâng Cao</h3>
                
                <div style="margin-bottom: 1.25rem;">
                    <label class="form-label">Trạng thái</label>
                    <select name="status" class="admin-input">
                        <option value="Ongoing" selected="@(Model.Status == "Ongoing" ? "selected" : null)">Đang cập nhật</option>
                        <option value="Completed" selected="@(Model.Status == "Completed" ? "selected" : null)">Hoàn thành</option>
                        <option value="Drop" selected="@(Model.Status == "Drop" ? "selected" : null)">Tạm ngưng</option>
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                    <div>
                        <label class="form-label">Lượt xem</label>
                        <input type="number" name="viewCount" class="admin-input" value="@Model.ViewCount">
                    </div>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label class="form-label">Rating (0-5)</label>
                    <div style="display:flex; align-items:center; gap: 10px;">
                        <input type="range" name="ratingAvg" min="0" max="5" step="0.1" value="@Model.RatingAvg" style="flex:1;" oninput="document.getElementById('ratingVal').innerText = this.value">
                        <span id="ratingVal" style="font-weight:700; color:var(--accent); width: 30px;">@Model.RatingAvg</span>
                    </div>
                </div>

                <div style="display: flex; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
                    <button type="submit" class="admin-btn btn-primary" id="btnSave" style="flex: 2;">Lưu Cập Nhật</button>
                    <a asp-controller="Admin" asp-action="Stories" class="admin-btn" style="flex: 1; background: var(--bg-body); border: 1px solid var(--border-color); color: var(--text-primary);">Hủy</a>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    $(document).ready(function() {
        $('.select2-genres').select2({ placeholder: "Chọn thể loại...", allowClear: true });
        const coverInput = document.getElementById('coverImage');
        const preview = document.getElementById('previewImage');
        coverInput.addEventListener('change', function(e) {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.opacity = '1';
                }
                reader.readAsDataURL(this.files[0]);
            }
        });
    });
</script>
