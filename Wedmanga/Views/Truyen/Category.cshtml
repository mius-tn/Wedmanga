@using Wedmanga.Models.Entities
@{
    var cat = ViewBag.Category as Category;
    ViewData["Title"] = cat != null ? $"Thể loại: {cat.Name}" : "Danh mục truyện";
}

@section Scripts {
    <style>
        .category-container {
            padding: 2rem 0;
        }

        .filter-section {
            background-color: var(--bg-surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--color-border);
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-soft);
        }

        .filter-row {
            display: flex;
            align-items: flex-start;
            margin-bottom: 1.25rem;
            gap: 1.5rem;
        }

        .filter-row:last-child {
            margin-bottom: 0;
            padding-top: 1.25rem;
            border-top: 1px dashed var(--color-border);
        }

        .filter-label {
            font-weight: 700;
            color: var(--text-primary);
            min-width: 100px;
            padding-top: 4px;
        }

        .filter-options {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .filter-chip {
            padding: 6px 16px;
            border-radius: var(--radius-pill);
            background-color: var(--bg-surface);
            border: 1px solid var(--color-border);
            color: var(--text-secondary);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition-smooth);
        }

        .filter-chip:hover {
            border-color: var(--color-sakura);
            color: var(--accent);
            background-color: var(--color-sakura-light);
        }

        .filter-chip.active {
            background-color: var(--color-sakura);
            color: white;
            border-color: var(--color-sakura);
            box-shadow: 0 4px 10px rgba(250, 218, 221, 0.4);
        }

        /* Grid Layout cho Truyện */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 1.5rem;
        }

        /* Tái sử dụng .manga-card từ Index nhưng override một số thông số grid */
        .grid-card {
            display: flex;
            flex-direction: column;
            background: var(--bg-surface);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-soft);
            transition: var(--transition-smooth);
            border: 1px solid var(--color-border);
            cursor: pointer;
            text-decoration: none;
            color: inherit;
        }

        .grid-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: var(--shadow-hover);
            border-color: var(--color-sakura-light);
        }

        .grid-img-wrapper {
            width: 100%;
            aspect-ratio: 1 / 1.4;
            overflow: hidden;
            position: relative;
        }

        .grid-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .grid-card:hover .grid-img {
            transform: scale(1.05); /* Zoom nhẹ ảnh khi hover */
        }

        .grid-content {
            padding: 1rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .grid-title {
            font-weight: 700;
            font-size: 1.05rem;
            margin-bottom: 0.5rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .grid-chapter {
            color: var(--accent);
            font-size: 0.85rem;
            font-weight: 600;
            margin-top: auto;
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 3rem;
        }

        .page-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--color-border);
            background: var(--bg-surface);
            color: var(--text-primary);
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            text-decoration: none;
        }

        .page-btn:hover {
            background: var(--color-sakura-light);
            color: var(--accent);
            border-color: var(--color-sakura);
        }

        .page-btn.active {
            background: var(--color-sakura);
            color: white;
            border-color: var(--color-sakura);
            box-shadow: 0 4px 10px rgba(250, 218, 221, 0.4);
        }

        @@media (max-width: 768px) {
            .filter-row {
                flex-direction: column;
                gap: 0.75rem;
            }
            .category-grid {
                grid-template-columns: repeat(2, 1fr); /* 2 cột trên điện thoại */
                gap: 1rem;
            }
        }
    </style>
}

<div class="container-custom category-container">
    <div style="margin-bottom: 2rem;">
        <h1 class="font-japanese" style="font-size: 2.5rem; color: var(--text-primary);">
            @(cat != null ? cat.Name : "Khám Phá")
        </h1>
        <p style="color: var(--text-secondary);">
            @(cat != null ? cat.Description : "Tìm kiếm những thể loại yêu thích của bạn")
        </p>
    </div>

    <!-- Thanh Lọc -->
    <div class="filter-section">
        <div class="filter-row">
            <div class="filter-label">Thể loại</div>
            <div class="filter-options">
                <a href="/the-loai/tat-ca?status=@ViewBag.CurrentStatus&sort=@ViewBag.CurrentSort" class="filter-chip @(ViewBag.CurrentSlug == "tat-ca" ? "active" : "")" style="text-decoration: none; display: inline-block;">Tất cả</a>
                @if (ViewBag.AllCategories != null)
                {
                    foreach (var catItem in (IEnumerable<Wedmanga.Models.Entities.Category>)ViewBag.AllCategories)
                    {
                        <a href="/the-loai/@catItem.Slug?status=@ViewBag.CurrentStatus&sort=@ViewBag.CurrentSort" class="filter-chip @(ViewBag.CurrentSlug == catItem.Slug ? "active" : "")" style="text-decoration: none; display: inline-block;">@catItem.Name</a>
                    }
                }
            </div>
        </div>

        <div class="filter-row">
            <div class="filter-label">Trạng thái</div>
            <div class="filter-options">
                <a href="/the-loai/@ViewBag.CurrentSlug?status=all&sort=@ViewBag.CurrentSort" class="filter-chip @(ViewBag.CurrentStatus == "all" ? "active" : "")" style="text-decoration: none; display: inline-block;">Tất cả</a>
                <a href="/the-loai/@ViewBag.CurrentSlug?status=ongoing&sort=@ViewBag.CurrentSort" class="filter-chip @(ViewBag.CurrentStatus == "ongoing" ? "active" : "")" style="text-decoration: none; display: inline-block;">Đang tiến hành</a>
                <a href="/the-loai/@ViewBag.CurrentSlug?status=completed&sort=@ViewBag.CurrentSort" class="filter-chip @(ViewBag.CurrentStatus == "completed" ? "active" : "")" style="text-decoration: none; display: inline-block;">Hoàn thành</a>
            </div>
        </div>

        <div class="filter-row">
            <div class="filter-label">Sắp xếp theo</div>
            <div class="filter-options">
                <a href="/the-loai/@ViewBag.CurrentSlug?status=@ViewBag.CurrentStatus&sort=newest" class="filter-chip @(ViewBag.CurrentSort == "newest" ? "active" : "")" style="text-decoration: none; display: inline-block;">Mới cập nhật</a>
                <a href="/the-loai/@ViewBag.CurrentSlug?status=@ViewBag.CurrentStatus&sort=views" class="filter-chip @(ViewBag.CurrentSort == "views" ? "active" : "")" style="text-decoration: none; display: inline-block;">Đọc nhiều nhất</a>
                <a href="/the-loai/@ViewBag.CurrentSlug?status=@ViewBag.CurrentStatus&sort=rating" class="filter-chip @(ViewBag.CurrentSort == "rating" ? "active" : "")" style="text-decoration: none; display: inline-block;">Đánh giá cao</a>
                <a href="/the-loai/@ViewBag.CurrentSlug?status=@ViewBag.CurrentStatus&sort=az" class="filter-chip @(ViewBag.CurrentSort == "az" ? "active" : "")" style="text-decoration: none; display: inline-block;">Tên: A-Z</a>
            </div>
        </div>
    </div>

    <!-- Grid List -->
    <div class="category-grid">
        @if (ViewBag.Stories != null) {
            var stories = (IEnumerable<Story>)ViewBag.Stories;
            foreach (var story in stories) {
                <a href="/truyen/@story.Slug" class="grid-card">
                    <div class="grid-img-wrapper">
                        @if (!string.IsNullOrEmpty(story.CoverImage)) {
                            <img src="@story.CoverImage" alt="@story.Title" class="grid-img" loading="lazy">
                        } else {
                            <div class="grid-img" style="background: linear-gradient(135deg, var(--color-sakura), var(--color-matcha)); display:flex; align-items:center; justify-content:center;">
                                <span class="material-symbols-rounded" style="color:white; opacity:0.7; font-size:48px;">image</span>
                            </div>
                        }
                    </div>
                    <div class="grid-content">
                        <h3 class="grid-title">@story.Title</h3>
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-top: auto;">
                            <span class="grid-chapter">Lượt xem: @story.ViewCount</span>
                            <div style="display: flex; align-items: center; gap: 4px; color: var(--text-secondary); font-size: 0.8rem;">
                                <span class="material-symbols-rounded" style="color: #ffd700; font-size: 14px;">star</span> @story.RatingAvg.ToString("0.0")
                            </div>
                        </div>
                    </div>
                </a>
            }
        }
    </div>

    <!-- Phân trang -->
    @if (ViewBag.TotalPages > 1) {
        int currentPage = ViewBag.CurrentPage ?? 1;
        int totalPages = ViewBag.TotalPages;
        string currentSlug = ViewBag.CurrentSlug ?? "tat-ca";
        <div class="pagination">
            @if (currentPage > 1) {
                <a href="/The-Loai/@currentSlug?page=@(currentPage - 1)&status=@ViewBag.CurrentStatus&sort=@ViewBag.CurrentSort" class="page-btn"><span class="material-symbols-rounded">chevron_left</span></a>
            }
            
            @for (int i = 1; i <= totalPages; i++) {
                <a href="/The-Loai/@currentSlug?page=@i&status=@ViewBag.CurrentStatus&sort=@ViewBag.CurrentSort" class="page-btn @(i == currentPage ? "active" : "")">@i</a>
            }
            
            @if (currentPage < totalPages) {
                <a href="/The-Loai/@currentSlug?page=@(currentPage + 1)&status=@ViewBag.CurrentStatus&sort=@ViewBag.CurrentSort" class="page-btn"><span class="material-symbols-rounded">chevron_right</span></a>
            }
        </div>
    }
</div>
