@{
    var currentPath = Context.Request.Path.Value ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wedmanga</title>
    
    <!-- Icons (Material Symbols Rounded) -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/manga-theme.css" asp-append-version="true" />
    
    <!-- Theme Check Script (Prevent Bright Flash) -->
    <script>
        (function() {
            var savedTheme = localStorage.getItem('theme');
            var systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
                // Apply theme immediately to document root to prevent FOUC
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
</head>
<body>
    <header class="site-header">
        <div class="nav-container">
            <a class="logo" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-rounded">auto_awesome</span>
                Manga<span>Yom</span>
            </a>
            
                <nav class="main-nav">
                    <a asp-controller="Home" asp-action="Index" class="@(currentPath == "/" || currentPath.StartsWith("/Home/Index", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Trang chủ</a>
                    <a asp-controller="Truyen" asp-action="Type" asp-route-type="Manga" class="@(currentPath.StartsWith("/The-Loai-Truyen/Manga", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Manga</a>
                    <a asp-controller="Truyen" asp-action="Type" asp-route-type="Light-Novel" class="@(currentPath.StartsWith("/The-Loai-Truyen/Light-Novel", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Light Novel</a>
                    <a asp-controller="Home" asp-action="Ranking" class="@(currentPath.StartsWith("/Home/Ranking", StringComparison.OrdinalIgnoreCase) ? "active" : "")">BXH</a>
                </nav>
            
                <div class="nav-actions">
                    <div class="search-bar">
                        <span class="material-symbols-rounded" style="color: var(--text-secondary); font-size: 20px;">search</span>
                        <input type="text" placeholder="Tìm kiếm truyện..." />
                    </div>
                
                    <button class="icon-btn theme-toggle" id="themeToggleBtn" aria-label="Toggle Dark Mode">
                        <span class="material-symbols-rounded" id="themeIcon">dark_mode</span>
                    </button>

                <a asp-controller="Account" asp-action="Profile" class="icon-btn hide-on-mobile" aria-label="Bookmarks" style="text-decoration:none;">
                    <span class="material-symbols-rounded">bookmarks</span>
                </a>
                
                <a asp-controller="Account" asp-action="Login" class="icon-btn hide-on-mobile" aria-label="Account" style="text-decoration:none;">
                    <span class="material-symbols-rounded">account_circle</span>
                </a>
                </div>
            </div>
    </header>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-custom">
            <p class="font-japanese" style="font-size: 1.25rem; margin-bottom: 0.5rem;">MangaYom</p>
            <p>&copy; 2026 - Giao diện Đọc truyện phong cách Nhật Bản tinh giản</p>
        </div>
    </footer>

    <!-- Mobile Bottom Navigation -->
    <nav class="mobile-bottom-nav">
        <ul class="mobile-nav-list">
            <li>
                <a asp-controller="Home" asp-action="Index" class="mobile-nav-item @(currentPath == "/" || currentPath.StartsWith("/Home/Index", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <span class="material-symbols-rounded">home</span>
                    <span>T.Chủ</span>
                </a>
            </li>
            <li>
                <a asp-controller="Truyen" asp-action="Type" asp-route-type="Manga" class="mobile-nav-item @(currentPath.StartsWith("/The-Loai-Truyen/Manga", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <span class="material-symbols-rounded">menu_book</span>
                    <span>Manga</span>
                </a>
            </li>
            <li>
                <a asp-controller="Truyen" asp-action="Type" asp-route-type="Light-Novel" class="mobile-nav-item @(currentPath.StartsWith("/The-Loai-Truyen/Light-Novel", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <span class="material-symbols-rounded">import_contacts</span>
                    <span>Novel</span>
                </a>
            </li>
            <li>
                <a asp-controller="Home" asp-action="Ranking" class="mobile-nav-item @(currentPath.StartsWith("/Home/Ranking", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <span class="material-symbols-rounded">explore</span>
                    <span>BXH</span>
                </a>
            </li>
            <li>
                <a asp-controller="Account" asp-action="Profile" class="mobile-nav-item @(currentPath.StartsWith("/tai-khoan/ho-so", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/profile", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/tai-khoan/dang-nhap", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/login", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <span class="material-symbols-rounded">account_circle</span>
                    <span>Hồ sơ</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Theme Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const themeToggleBtn = document.getElementById('themeToggleBtn');
            const themeIcon = document.getElementById('themeIcon');
            const root = document.documentElement;

            // Sync icon on load based on what was set in head script
            if (root.getAttribute('data-theme') === 'dark') {
                document.body.setAttribute('data-theme', 'dark'); // Set on body too just in case existing css relies on it
                if (themeIcon) themeIcon.textContent = 'light_mode';
            }

            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', () => {
                    if (root.getAttribute('data-theme') === 'dark') {
                        root.removeAttribute('data-theme');
                        document.body.removeAttribute('data-theme');
                        localStorage.setItem('theme', 'light');
                        if (themeIcon) themeIcon.textContent = 'dark_mode';
                    } else {
                        root.setAttribute('data-theme', 'dark');
                        document.body.setAttribute('data-theme', 'dark');
                        localStorage.setItem('theme', 'dark');
                        if (themeIcon) themeIcon.textContent = 'light_mode';
                    }
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
